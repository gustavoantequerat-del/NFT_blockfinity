# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.

# Clave secreta para firmar los tokens JWT.
# Usa una cadena larga y aleatoria, por ejemplo: openssl rand -hex 32
JWT_SECRET=

# Puerto en el que escucha el servidor (opcional, por defecto 3000)
PORT=3000

# ---------------------------------------------------------------
# Blockchain (red donde vive el contrato de certificados)
# ---------------------------------------------------------------
RPC_URL=
EXPECTED_CHAIN_ID=
EXPLORER_BASE_URL=
UNIVERSITY_WALLET=
PRIVATE_KEY=
CONTRACT_ADDRESS=

# ---------------------------------------------------------------
# Pinata (IPFS) - https://app.pinata.cloud/developers/api-keys
# ---------------------------------------------------------------
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# ---------------------------------------------------------------
# Posición del nombre del alumno dentro de la plantilla PDF.
# Y se mide desde abajo hacia arriba (origen PDF). X se centra automáticamente.
# ---------------------------------------------------------------
CERT_NAME_PAGE_INDEX=0
CERT_NAME_Y=300
CERT_NAME_FONT_SIZE=28
