# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.

# Clave para firmar las sesiones (JWT). Ejemplo: openssl rand -hex 32
JWT_SECRET=

# Puerto del servidor (por defecto 3000)
PORT=3000

# ---------------------------------------------------------------
# Credenciales por modo de red
# ---------------------------------------------------------------
# El administrador cambia entre TEST y MAIN desde el panel
# (Configuración → Red de emisión). Cada modo usa SOLO sus variables.
#
#   TEST: testnet (ej. Sepolia, chain id 11155111). Para probar funciones
#         nuevas sin costo real: gas de prueba y no descuenta crédito.
#   MAIN: red principal (ej. Ethereum, chain id 1). Gas y costos reales.
#
# La wallet emisora se deriva de PRIVATE_KEY_* y debe ser owner del
# contrato CONTRACT_ADDRESS_* de esa misma red.
# EXPLORER_URL_* es opcional: para las redes conocidas se completa sola.

# ----- TEST -----
RPC_URL_TEST=
CHAIN_ID_TEST=11155111
PRIVATE_KEY_TEST=
CONTRACT_ADDRESS_TEST=
PINATA_API_KEY_TEST=
PINATA_SECRET_API_KEY_TEST=
EXPLORER_URL_TEST=

# ----- MAIN -----
RPC_URL_MAIN=
CHAIN_ID_MAIN=1
PRIVATE_KEY_MAIN=
CONTRACT_ADDRESS_MAIN=
PINATA_API_KEY_MAIN=
PINATA_SECRET_API_KEY_MAIN=
EXPLORER_URL_MAIN=

# ---------------------------------------------------------------
# QR de verificación
# ---------------------------------------------------------------
# Dominio público donde se sirve el panel. El QR apunta a
#   <PUBLIC_VERIFY_URL>?token=<tokenId>&cid=<cid del PDF>&red=<test|main>
# Si queda vacío se usa el host del request (ej. http://localhost:3000/),
# que NO sirve fuera de tu máquina.
PUBLIC_VERIFY_URL=

# Posición y tamaño del QR en puntos PDF (se ancla abajo a la derecha).
CERT_QR_PAGE_INDEX=0
CERT_QR_SIZE=84
CERT_QR_MARGIN=28

# ---------------------------------------------------------------
# Nombre del alumno dentro de la plantilla PDF
# Y se mide desde abajo. X se centra sola.
# ---------------------------------------------------------------
CERT_NAME_PAGE_INDEX=0
CERT_NAME_Y=300
CERT_NAME_FONT_SIZE=28

# ---------------------------------------------------------------
# Semilla de cuentas de prueba (npm run seed)
# Wallet del estudiante demo. Vacío = cuenta #1 pública de Hardhat (solo test).
# ---------------------------------------------------------------
DEMO_STUDENT_WALLET=
